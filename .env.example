# Application
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Auth (CHANGE IN PRODUCTION!)
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=24h
ADMIN_TOKEN=dev-admin-token-change-in-production
ENABLE_DEV_AUTH=true

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seat_reservation
DATABASE_DIRECT_URL=postgres://postgres:postgres@localhost:5432/seat_reservation

# Observability
METRICS_LOG_FILE=/tmp/metrics.log
METRICS_LOG_INTERVAL_MS=30000