{
  "name": "seat-reservation",
  "version": "0.1.0",
  "description": "Atomic seat reservation API under extreme concurrency",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "burst": "bash scripts/burst.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^9.0.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "prom-client": "^15.1.3",
    "jsonwebtoken": "^9.0.2",
    "undici": "^6.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/jsonwebtoken": "^9.0.6",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.4",
    "eslint": "^9.8.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}